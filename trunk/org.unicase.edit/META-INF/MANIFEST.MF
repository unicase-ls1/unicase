Manifest-Version: 1.0
Bundle-ManifestVersion: 2
Bundle-Name: unicase Edit Plugin
Bundle-SymbolicName: org.unicase.edit;singleton:=true
Bundle-Version: 0.0.1
Bundle-ClassPath: .
Bundle-Activator: org.unicase.edit.ModelEditPlugin$Implementation
Bundle-Vendor: unicase.org
Bundle-Localization: plugin
Bundle-RequiredExecutionEnvironment: J2SE-1.5
Export-Package: org.unicase.edit;uses:="org.eclipse.emf.common,org.eclipse.emf.common.util",
